# ============================================================
# it's_not_me_its_you — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your real values.

# --- Claude API ---
# Two ways to authenticate, in order of preference:
#
#   (a) Run inside Claude Code (or any environment that already exports
#       ANTHROPIC_AUTH_TOKEN + ANTHROPIC_BASE_URL — e.g. a Salesforce or
#       company AI gateway). In that case you do NOT need to set anything
#       below; the skill auto-detects the gateway.
#
#   (b) Direct Anthropic API: get a key from https://console.anthropic.com/
#       and uncomment the line below.
#
# ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
